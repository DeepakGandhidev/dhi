{
  "name": "dhi-international",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "next lint",
    "dev:db": "node scripts/dev-mongo.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "tsx --env-file=.env.local scripts/migrate.ts",
    "db:seed": "tsx --env-file=.env.local scripts/seed.ts"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "mongoose": "^8.9.5",
    "next": "^15.5.25",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "mongodb-memory-server": "^11.2.0",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3",
    "vitest": "^3.2.7"
  },
  "overrides": {
    "postcss": "^8.5.28"
  }
}
